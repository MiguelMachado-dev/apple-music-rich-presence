<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <AssemblyName>AppleMusicPresence</AssemblyName>
    <Product>Apple Music Presence</Product>
    <Description>Apple Music no Discord, direto da bandeja do Windows.</Description>
    <Version>0.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AppleMusicPresence.Core/AppleMusicPresence.Core.csproj" />
    <Resource Include="../../assets/app.ico" Link="Assets/app.ico" />
  </ItemGroup>
</Project>
